  22:../cyfxslfifosync.c **** #define CY_FX_GPIOAPP_GPIO_HIGH_EVENT    (1 << 0)   /* GPIO high event */
  23:../cyfxslfifosync.c **** #define CY_FX_GPIOAPP_GPIO_LOW_EVENT     (1 << 1)   /* GPIO low event */
  24:../cyfxslfifosync.c **** /* Magnetic switch state change event (used to drive the magnetic thread) */
  25:../cyfxslfifosync.c **** #define CY_FX_GPIOAPP_MAGNETIC_EVENT     (1 << 2)
  26:../cyfxslfifosync.c **** #define CY_FX_APP_SELF_INIT_EVENT        (1 << 3)   /* Request device self-init in thread context. 
  27:../cyfxslfifosync.c **** /* Runtime IO matrix GPIO[63:32] bitmap. Keep this in sync with CyFxApplicationDefine. */
  28:../cyfxslfifosync.c **** #define CY_FX_RUNTIME_GPIO_SIMPLE_EN1    (0x121C2000u)
  29:../cyfxslfifosync.c **** #define CY_FX_BINNING_SETTLE_DELAY_MS    (100u)
  30:../cyfxslfifosync.c **** #define CY_FX_BINNING_VERIFY_RETRY_DELAY_MS (20u)
  31:../cyfxslfifosync.c **** //#define DEF_UART_BAUDRATE                (115200)    /* Baud rate for UART communication. */
  32:../cyfxslfifosync.c **** CyU3PEvent glFxGpioAppEvent;            /* GPIO input event group. */
  33:../cyfxslfifosync.c **** CyU3PThread slHeatingAppThread;            /* Temperature monitor application thread structure  */
  34:../cyfxslfifosync.c **** CyU3PThread slMagneticSwitchAppThread;            /* Slave Heating application thread structure  */
