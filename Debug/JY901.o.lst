   1:../JY901.c    **** /*
   2:../JY901.c    ****  * JY901.c
   3:../JY901.c    ****  *
   4:../JY901.c    ****  * 基于 FX3 I2C 总线的 JY901 / JY901S 9轴惯性传感器完整驱动
   5:../JY901.c    ****  * 参考 WitMotion SDK 和 STM32 示例实现
   6:../JY901.c    ****  *
   7:../JY901.c    ****  * 使用方法：
   8:../JY901.c    ****  *   1. 在主程序中初始化 I2C：JY901_I2C_Init();
   9:../JY901.c    ****  *   2. 可选：设置设备地址 JY901_SetAddress(0x50);
  10:../JY901.c    ****  *   3. 初始化传感器：JY901_Init();
  11:../JY901.c    ****  *   4. 读取数据：
  12:../JY901.c    ****  *      - JY901_ReadAll();                         // 一次性读取所有数据到全局寄存器
  13:../JY901.c    ****  *      - JY901_ReadAngles(&roll,&pitch,&yaw);     // 读取姿态角
  14:../JY901.c    ****  *      - JY901_ReadRawGyro(&gx,&gy,&gz);          // 读取原始角速度
  15:../JY901.c    ****  *      - JY901_ReadRawAccel(&ax,&ay,&az);         // 读取原始加速度
  16:../JY901.c    ****  *      - JY901_ReadMag(&mx,&my,&mz);              // 读取磁力计
  17:../JY901.c    ****  *   5. 校准：
  18:../JY901.c    ****  *      - JY901_StartAccCali();                    // 开始加速度计校准
  19:../JY901.c    ****  *      - JY901_StartMagCali() / JY901_StopMagCali(); // 磁力计校准
  20:../JY901.c    ****  */
